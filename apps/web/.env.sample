# Environment variables for apps/web (Next.js dev server, run outside Docker).
#
# Copy this file to .env.local and adjust if needed:
#   cp .env.sample .env.local
#
# Not prefixed with NEXT_PUBLIC_, so it's only readable on the server side (API route handlers /
# server components) — never bundled into client-side JS. See app/lib/api.ts and lib/api-proxy.ts.

# Base URL of the backend API that this app's route handlers proxy requests to.
# Default works out of the box against `make backend` / `docker-compose` (backend on port 8000).
BACKEND_URL=http://localhost:8000
