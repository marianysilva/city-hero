# Only needed when running backend outside Docker (locally).
# When using docker-compose, the root .env is used instead.

APP_NAME=CityHero API
DATABASE_URL=postgresql+asyncpg://cityhero:your-password@localhost:5432/cityhero
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=60
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8081

# Test database (required for pytest)
TEST_DATABASE_URL=postgresql+asyncpg://cityhero:your-password@localhost:5432/cityhero_test
