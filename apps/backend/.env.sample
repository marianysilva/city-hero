# Environment variables for apps/backend.
#
# Only needed when running the backend outside Docker (e.g. `uvicorn main:app --reload` locally).
# When using `docker-compose` / `make start`, the root .env is used instead.
# Loaded via pydantic-settings — see app/core/config.py (Settings class, env_file=".env").
#
# Copy this file to .env and fill in the values below:
#   cp .env.sample .env

# --- App ---

# Display name used in API metadata (e.g. the Swagger /docs title). Safe to leave as-is.
APP_NAME=CityHero API

# Enables FastAPI debug mode (verbose tracebacks). Never enable in production.
DEBUG=false

# --- Database ---

# SQLAlchemy async connection string: postgresql+asyncpg://<user>:<password>@<host>:<port>/<db>
# Used by app/core/database.py to build the async engine/session factory.
# The default below assumes a local PostgreSQL instance with a `cityhero` database created.
DATABASE_URL=postgresql+asyncpg://cityhero:cityhero@localhost:5432/cityhero

# --- Auth (JWT) ---

# Symmetric key used to sign/verify JWTs (app/core/security.py). The app refuses to start if this
# is shorter than 32 characters (see Settings.secret_key_must_be_strong in app/core/config.py).
# Required — no default. Generate with: openssl rand -hex 32
SECRET_KEY=

# How long an issued access token stays valid, in minutes. Tokens are short-lived by design;
# there is no refresh-token flow yet, so the user must log in again after it expires.
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- CORS ---

# Comma-separated list of origins allowed to call the API from a browser. Add an origin here
# whenever a new frontend host/port (web dashboard, mobile web preview) needs to reach the API.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8081

# --- Seed users (alembic/versions/005_seed_default_users.py) ---
#
# Migration 005 creates one bootstrap login per role — admin, mayor, secretary, dispatcher,
# field_team, citizen — so there are accounts to log in with locally. It only runs the insert
# when both passwords below are set; re-running the migration is a no-op either way
# (ON CONFLICT DO NOTHING), so it's safe to leave populated across runs.
# Leave both password fields empty to disable seeding (e.g. CI or automated test environments).

# Email for the admin seed user.
APP_ADMIN=admin@cityhero.com

# Password for the admin seed user. Required for migration 005 to seed anything — use a strong
# password. Generate with: openssl rand -base64 24
APP_ADMIN_PASSWORD=

# Shared password for the other five seed users (mayor@, secretary@, dispatcher@, field_team@,
# citizen@ — all @cityhero.com). Required for migration 005 to seed anything.
# Generate with: openssl rand -base64 24
APP_USERS_PASSWORD=
