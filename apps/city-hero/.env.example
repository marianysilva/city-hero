# Copy to .env.development.local (gitignored — see .gitignore's `.env*.local`)
# and uncomment what you need. Values here are never committed.

# Backend base URL (see lib/api-client.ts). Defaults to http://localhost:8000.
# EXPO_PUBLIC_API_URL=http://localhost:8000

# Dev-only: force the app's default language without changing your OS locale
# (see lib/i18n.ts and docs/tasks/00-foundation/13-i18n.md). Only read when
# __DEV__ is true — has no effect in a production build. One of: pt-BR, en-US.
# EXPO_PUBLIC_DEFAULT_LOCALE=pt-BR
