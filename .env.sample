# Environment variables for docker-compose (root .env).
# Read by all services — db, backend, web, mobile — via `${VAR}` interpolation in docker-compose.yml.
# Each service only receives the variables it declares in its own `environment:` block.
#
# Copy this file to .env and fill in real values:
#   cp .env.sample .env
#
# For running the backend locally outside Docker, see apps/backend/.env.sample instead.

# --- PostgreSQL (db service) ---

# Superuser created by the official postgres image on first container boot. Also reused below to
# build DATABASE_URL for the backend.
POSTGRES_USER=cityhero

# Password for POSTGRES_USER. Required — no default. Must match the password segment of
# DATABASE_URL below, or the backend won't be able to authenticate.
POSTGRES_PASSWORD=your-password-here

# Database name created on first container boot.
POSTGRES_DB=cityhero

# --- Backend (FastAPI service) ---

# Display name used in API metadata (e.g. the Swagger /docs title). Safe to leave as-is.
APP_NAME=CityHero API

# SQLAlchemy async connection string. Host is `db` — the docker-compose service name — not
# `localhost`, since backend and db run as separate containers on the compose network.
# Must reuse the same user/password/db as the POSTGRES_* values above.
DATABASE_URL=postgresql+asyncpg://cityhero:your-password-here@db:5432/cityhero

# Symmetric key used to sign/verify JWTs. Required — the backend refuses to start with fewer than
# 32 characters. Generate with: openssl rand -hex 32
SECRET_KEY=your-secret-key-here

# How long an issued access token stays valid, in minutes.
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Comma-separated list of origins allowed to call the API from a browser (web dashboard, mobile
# web preview). Add an origin here whenever a new frontend host/port needs to reach the API.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8081

# --- Seed users (alembic migration 005) ---
# Creates one bootstrap login per role (admin, mayor, secretary, dispatcher, field_team, citizen)
# the first time migrations run — re-running is a no-op. Leave APP_ADMIN_PASSWORD and
# APP_USERS_PASSWORD empty to disable seeding.

# Login identifier for the admin seed user, stored as `users.email` — use an email address.
APP_ADMIN=admin

# Password for the admin seed user. Required for the seed migration to insert anything.
APP_ADMIN_PASSWORD=admin_password

# Shared password for the other five seed users (mayor, secretary, dispatcher, field_team,
# citizen). Required for the seed migration to insert anything.
APP_USERS_PASSWORD=user_password
